# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID — same page, "General Information" → Application ID
CLIENT_ID=your-application-id-here

# The single guild (server) this bot serves. Right-click your server icon →
# "Copy Server ID" (needs Developer Mode enabled in Discord settings).
GUILD_ID=your-server-id-here

# ── Behaviour ────────────────────────────────────────────────────────────
# Where the SQLite database file lives (relative paths are fine).
DATABASE_PATH=./data/1984bot.sqlite

# Which channels to log messages from — comma-separated names and/or ids.
# Threads inherit their parent channel. Leave EMPTY to log every channel the
# bot can see. Example: MESSAGE_CHANNELS=the-resources,general
MESSAGE_CHANNELS=the-resources

# Set to false to stop the bot replying when someone @s it.
MENTION_REPLIES=true

# Request the privileged Message Content intent. Set to false if it isn't
# enabled in the Developer Portal — Discord rejects the login otherwise.
# Who-tags-whom still works without it; word counts and keyword replies don't.
MESSAGE_CONTENT=true

# ── Severe weather alerts ────────────────────────────────────────────────
# Watched locations live in the database and are managed in Discord with the
# /weather command (add / remove / subscribe / unsubscribe / list) — nothing
# below is required. This variable only SEEDS the database on first boot, if
# it's still empty. Format: "Name|lat,lon|user,user" entries separated by ";",
# users being Discord names to ping (username / display name / nickname).
# Example:
#   WEATHER_LOCATIONS=Hillsborough NC|36.0754,-79.0997|gfreek; Ewa Beach HI|21.3156,-158.0072|
WEATHER_LOCATIONS=

# Channel (name or id) the alerts go to.
WEATHER_CHANNEL=gord-bot

# Which NWS event types to post, comma-separated. Other options include
# "Tornado Watch" and "Severe Thunderstorm Watch".
WEATHER_EVENTS=Severe Thunderstorm Warning,Tornado Warning

# Ping with each alert: empty (no ping), "here", "everyone", or a role id.
WEATHER_MENTION=

# ── SMITE 2 session announcements ────────────────────────────────────────
# When a member starts playing SMITE 2, post their stat card (rank, win
# rates, top gods — from their linked smite2.live profile), and post match
# reports as linked members' matches finish. Members link themselves with
# /smite link. Set to false to turn the whole thing off.
SMITE_WATCH=true

# Channel (name or id) the SMITE posts go to.
SMITE_CHANNEL=gord-bot

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Path to the yt-dlp binary (leave as "yt-dlp" if it's on your PATH).
YTDLP_PATH=yt-dlp

# Path to the ffmpeg binary (leave as "ffmpeg" if it's on your PATH).
FFMPEG_PATH=ffmpeg
