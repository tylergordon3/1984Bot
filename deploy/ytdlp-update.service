[Unit]
Description=Update yt-dlp
OnFailure=notify@%n.service

[Service]
Type=oneshot
# yt-dlp self-updates by rewriting its own binary, so it lives under ~/.local/bin
# where this user owns it. An earlier version updated the copy in /usr/local/bin
# via sudo, which only worked while a cached sudo credential happened to be
# valid and failed once that expired.
ExecStart=%h/.local/bin/yt-dlp -U
