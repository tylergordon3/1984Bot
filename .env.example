# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID — same page, "General Information" → Application ID
CLIENT_ID=your-application-id-here

# The single guild (server) this bot serves. Right-click your server icon →
# "Copy Server ID" (needs Developer Mode enabled in Discord settings).
GUILD_ID=your-server-id-here

# ── Behaviour ────────────────────────────────────────────────────────────
# Where the SQLite database file lives (relative paths are fine).
DATABASE_PATH=./data/1984bot.sqlite

# Which channels to log messages from — comma-separated names and/or ids.
# Threads inherit their parent channel. Leave EMPTY to log every channel the
# bot can see. Example: MESSAGE_CHANNELS=the-resources,general
MESSAGE_CHANNELS=the-resources

# Set to false to stop the bot replying when someone @s it.
MENTION_REPLIES=true

# Request the privileged Message Content intent. Set to false if it isn't
# enabled in the Developer Portal — Discord rejects the login otherwise.
# Who-tags-whom still works without it; word counts and keyword replies don't.
MESSAGE_CONTENT=true

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Path to the yt-dlp binary (leave as "yt-dlp" if it's on your PATH).
YTDLP_PATH=yt-dlp

# Path to the ffmpeg binary (leave as "ffmpeg" if it's on your PATH).
FFMPEG_PATH=ffmpeg
