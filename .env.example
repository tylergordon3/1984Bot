# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID — same page, "General Information" → Application ID
CLIENT_ID=your-application-id-here

# The single guild (server) this bot serves. Right-click your server icon →
# "Copy Server ID" (needs Developer Mode enabled in Discord settings).
GUILD_ID=your-server-id-here

# ── Behaviour ────────────────────────────────────────────────────────────
# Where the SQLite database file lives (relative paths are fine).
DATABASE_PATH=./data/1984bot.sqlite

# Which channels to log messages from — comma-separated names and/or ids.
# Threads inherit their parent channel. Leave EMPTY to log every channel the
# bot can see. Example: MESSAGE_CHANNELS=the-resources,general
MESSAGE_CHANNELS=the-resources

# Set to false to stop the bot replying when someone @s it.
MENTION_REPLIES=true

# Request the privileged Message Content intent. Set to false if it isn't
# enabled in the Developer Portal — Discord rejects the login otherwise.
# Who-tags-whom still works without it; word counts and keyword replies don't.
MESSAGE_CONTENT=true

# ── Severe weather alerts ────────────────────────────────────────────────
# Watched locations live in the database and are managed in Discord with the
# /weather command (add / remove / subscribe / unsubscribe / list) — nothing
# below is required. This variable only SEEDS the database on first boot, if
# it's still empty. Format: "Name|lat,lon|user,user" entries separated by ";",
# users being Discord names to ping (username / display name / nickname).
# Example:
#   WEATHER_LOCATIONS=Hillsborough NC|36.0754,-79.0997|gfreek; Ewa Beach HI|21.3156,-158.0072|
WEATHER_LOCATIONS=

# Channel (name or id) the alerts go to.
WEATHER_CHANNEL=gord-bot

# Which NWS event types to notify on, comma-separated. Warnings only by
# default; swap in the commented line below to be pinged for watches as well.
# Other options include "Flash Flood Warning", "Winter Storm Warning" and
# "High Wind Warning". This gates the pings only — /weather map always shows
# every alert in effect, watches included.
WEATHER_EVENTS=Severe Thunderstorm Warning,Tornado Warning
#WEATHER_EVENTS=Severe Thunderstorm Warning,Tornado Warning,Severe Thunderstorm Watch,Tornado Watch

# Ping with each alert: empty (no ping), "here", "everyone", or a role id.
WEATHER_MENTION=

# Attach a map of the warned area (NWS polygons over OpenStreetMap tiles, with
# the watched location marked) to each alert. Set to false for text-only
# alerts; /weather map still draws one on request either way.
WEATHER_MAPS=true

# Overlay NEXRAD radar on those maps, so the post shows the actual storm inside
# the warned polygon rather than just the outline. Imagery is about 5 minutes
# old. Where there's no radar coverage the map is simply drawn without it.
WEATHER_RADAR=true

# ── Scheduled digest ─────────────────────────────────────────────────────
# The Ministry's report: top talkers, voice time, top games, who was alone,
# who was inseparable, and the day's busiest hour — built from the statistics
# already being collected, posted on a schedule. A period with no activity
# posts nothing, and a restart never replays an edition it already sent (nor
# fires one whose hour has already passed).
DIGEST_ENABLED=true

# Channel (name or id) the reports go to.
DIGEST_CHANNEL=gord-bot

# Local hour (0–23) the report goes out. The daily edition covers the previous
# 24 hours, the weekly one the previous 7 days.
DIGEST_HOUR=9

# Which editions to send.
DIGEST_DAILY=true
DIGEST_WEEKLY=true

# Weekday for the weekly edition: 0 = Sunday, 1 = Monday … 6 = Saturday.
DIGEST_WEEKLY_DAY=0

# ── Milestones ───────────────────────────────────────────────────────────
# Announcements when someone crosses a round number (100 hours in voice, 1,000
# messages, 250 hours in one game, 100 hours alone, 100 hours with the same
# person) or breaks a server record (longest voice session, longest unbroken
# game session, most messages in a day).
#
# The first run after switching this on takes a BASELINE: everything already
# achieved is written down silently, so nothing historic is ever announced.
# Only what happens afterwards gets posted.
MILESTONES_ENABLED=true

# Channel (name or id) for milestone posts. Defaults to DIGEST_CHANNEL.
MILESTONE_CHANNEL=gord-bot

# ── SMITE 2 session announcements ────────────────────────────────────────
# When a member starts playing SMITE 2, post their stat card (rank, win
# rates, top gods — from their linked smite2.live profile), and post match
# reports as linked members' matches finish. Members link themselves with
# /smite link.
#
# Master switch for the whole utility — the /smite command included. It is OFF
# unless this is exactly "true", so the feature stays dormant until you want it.
# Changing it needs `npm run deploy` to add or remove the slash command.
SMITE_ENABLED=false

# Channel (name or id) the SMITE posts go to.
SMITE_CHANNEL=gord-bot

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Path to the yt-dlp binary (leave as "yt-dlp" if it's on your PATH).
YTDLP_PATH=yt-dlp

# Path to the ffmpeg binary (leave as "ffmpeg" if it's on your PATH).
FFMPEG_PATH=ffmpeg
